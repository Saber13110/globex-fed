DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/globex_fedex
JWT_SECRET_KEY=remplacer-par-une-cle-longue-et-aleatoire
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_EMAIL=admin@globex.ma
ADMIN_PASSWORD=change-me-admin-password
ADMIN_FULL_NAME=Administrateur Globex
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
GOOGLE_CLIENT_ID=
TWO_FACTOR_ENABLED=true
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
PROMPT_GUARD_ENABLED=true
PROMPT_GUARD_BLOCK_THRESHOLD=70
PROMPT_GUARD_WARN_THRESHOLD=40
PROMPT_GUARD_BLOCK_CHAT=true
# false = pas d’email ; l’admin voit les soumissions dans l’UI (onglet Préférences à valider)
NOTIFY_ADMIN_ON_PREFERENCE_SUBMIT=false
# Si true : SMTP_* requis + adresse réelle (sinon tous les comptes admin actifs)
ADMIN_NOTIFY_EMAIL=
FRONTEND_BASE_URL=http://localhost:4200
DEBUG=false
# LLM — Ollama uniquement pour le client Phase 2 (pas de Gemini requis pour le chat client).
# Prérequis : ollama serve && ollama pull qwen2.5:7b-instruct — redémarrer le backend après changement.
LLM_ENABLED=true
LLM_PRIMARY_PROVIDER=ollama
LLM_FALLBACK_PROVIDER=ollama
# Laisser vide pour forcer Ollama seul (RAG vectoriel désactivé sans clé Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
# Si 503 (surcharge), essai automatique de ces modèles avant Ollama
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash-lite,gemini-2.0-flash-001
GEMINI_RETRY_ON_503=true
GEMINI_TIMEOUT_SECONDS=45
GEMINI_QUOTA_COOLDOWN_SECONDS=900
# Limite d'appels Gemini par question copilot (évite 5-10 appels / 429)
GEMINI_MAX_CALLS_PER_REQUEST=2
GEMINI_MAX_CALLS_AGENT_MODE=4
OLLAMA_BASE_URL=http://localhost:11434
# Phase 1 client : qwen2.5:7b-instruct (ollama pull qwen2.5:7b-instruct) — redémarrer le backend après changement
OLLAMA_MODEL=qwen2.5:7b-instruct
# Phase 1 Ollama passthrough : ne pas bloquer le chat avant Ollama (log guard OK)
PROMPT_GUARD_BLOCK_CHAT=false
# Délai lecture Ollama (secondes). Sur CPU (ollama ps → 100% CPU), mettre 300.
# Précharger le modèle avant tests chat : ollama run qwen2.5:7b-instruct puis vérifier ollama ps.
# Phase 1 chat : call_ollama_simple (prompt court). Phase 2 suivi : call_ollama_tracking (léger) ; erreurs FedEx sans LLM.
OLLAMA_TIMEOUT_SECONDS=120
AI_TIMEOUT_SECONDS=30
AI_ENABLE_LOCAL_FALLBACK=true
LLM_MAX_PROMPT_CHARS=1500
USE_DETERMINISTIC_FEDEX_REPLY=false
# false = succès ET erreurs FedEx reformulés par Ollama/Gemini ; true = templates serveur uniquement (debug)
# FEDEX sandbox : numéros de test whitelistés (ex. 881135077232) — voir fedex_sandbox_whitelist.py
# true = réponses client mockées (tests hors Gemini/Ollama) — voir client_chat_mock.py
MOCK_CLIENT_CHAT_ENABLED=false
# Alias historiques (optionnel)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=gemma3:4b
GPT_TOOLS_ENABLED=true
# Phase 3 client — LLM + outils (PDF, export). false = rollback export_turn déterministe
CLIENT_TOOL_LOOP_ENABLED=true
# true = bonjour/FAQ via Ollama léger (sans boucle outils) ; false = tout vers tool loop
CLIENT_CONVERSATIONAL_FAST_PATH=true
# Phase 3b : PDF post-réponse LLM — le chat rédige d'abord, fpdf emballe ensuite (pas de routeur mots-clés pré-chat)
# Activer pdf dans CLIENT_AGENT_CAPABILITIES pour les liens de téléchargement PDF
# Phase 2 : chat client = call_ollama_simple (général) + call_ollama_tracking (suivi)
# Capacités : chat | fedex | pdf | excel | sessions
CLIENT_AGENT_CAPABILITIES=chat,fedex,pdf,excel,sessions,notifications,watch,email_export,daily_report
# Phase 8 — envoi automatique rapport quotidien (dormant ; envoi à la demande via chat)
DAILY_REPORT_SCHEDULER_ENABLED=false
# Phase 4 — routeur Ollama (conversations list/summarize). false = comportement actuel inchangé
CLIENT_AGENT_ROUTER_ENABLED=false
GPT_RAG_VECTOR_ENABLED=true
GPT_RAG_PGVECTOR_ENABLED=true
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
KNOWLEDGE_UPLOAD_MAX_MB=15
# true = appels API FedEx réels ; false = colis mock (tests sans clés)
FEDEX_ENABLED=true
FEDEX_BASE_URL=https://apis-sandbox.fedex.com
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ACCOUNT_NUMBER=
FEDEX_LOCALE=fr_CA
FEDEX_TIMEOUT_SECONDS=20
# Location Search API (centres FedEx) — optionnel si mêmes clés que le tracking
FEDEX_LOCATION_CLIENT_ID=
FEDEX_LOCATION_CLIENT_SECRET=
# Advanced Integrated Visibility (webhook simulé + sync sur tracking)
FEDEX_VISIBILITY_SIMULATION_ENABLED=true
FEDEX_VISIBILITY_SYNC_ON_TRACK=true
# Secret optionnel pour POST /api/fedex/webhooks/visibility (vide = pas de vérification en dev)
FEDEX_WEBHOOK_SECRET=

# Mode Agent — surveillance colis (e-mail si changement de statut)
SHIPMENT_WATCH_ENABLED=true
SHIPMENT_WATCH_INTERVAL_SECONDS=60

# Jarvis-OS — Agent Window admin (sidecar sur port 8010)
JARVIS_ENABLED=true
JARVIS_BASE_URL=http://127.0.0.1:8010
JARVIS_API_TOKEN=
JARVIS_TIMEOUT_SECONDS=120
JARVIS_INJECT_CONTEXT=true
JARVIS_CONTEXT_MAX_CHARS=2000
JARVIS_MAX_HISTORY_TURNS=10

# Globex OS Agent — API /api/globex-agent/* (remplace le copilot)
GLOBEX_AGENT_ENABLED=true

# Globex OS — scheduler proactif Phase 4
GLOBEX_PROACTIVE_ENABLED=true
GLOBEX_PROACTIVE_INTERVAL_SECONDS=300
GLOBEX_PROACTIVE_SLA_LIMIT=10
GLOBEX_PROACTIVE_DORMANT_DAYS=30
GLOBEX_PROACTIVE_DORMANT_LIMIT=10
